{
  "unit": 10,
  "title": "명령문 & Let's (Please ~ / Don't ~ / Let's ~)",
  "emoji": "👉",
  "goal": "'~하세요', '~하지 마세요', '같이 ~해요'를 영어로 말하고 알아들을 수 있어요.",
  "points": [
    { "title": "동사로 바로 시작해요", "body": "'~하세요, ~해'라고 시킬 때는 주어 없이 동사원형으로 시작해요. Wait here. / Open the door." },
    { "title": "Please로 부드럽게", "body": "Please를 앞이나 뒤에 붙이면 공손해져요. Please wait here. / Wait here, please. 일할 때나 손님한테는 꼭 붙여 주세요." },
    { "title": "하지 마세요 = Don't", "body": "'~하지 마세요'는 Don't + 동사원형이에요. Don't run. / Don't touch it. Not이나 No로 시작하지 않아요." },
    { "title": "be동사 명령은 Be", "body": "careful(조심하는), late(늦은)처럼 상태를 말할 때는 Be를 써요. Be careful! / Don't be late! 'Don't late'처럼 be를 빼면 틀려요." },
    { "title": "같이 해요 = Let's", "body": "'우리 같이 ~해요/하자'는 Let's + 동사원형이에요. Let's go to the beach! '~하지 말자'는 Let's not + 동사원형이에요." }
  ],
  "formula": [
    "(Please) + 동사원형 + ... (+ please)",
    "Don't + 동사원형 + ...",
    "Be / Don't be + 상태 말 (careful, late, shy ...)",
    "Let's (not) + 동사원형 + ..."
  ],
  "mistakes": [
    { "wrong": "Don't late for work.", "right": "Don't be late for work.", "why": "'늦지 마'를 그대로 옮기면 be가 빠져요. late는 동사가 아니라서 Don't be late로 써요." },
    { "wrong": "Let's going to the beach.", "right": "Let's go to the beach.", "why": "'가자'를 진행형처럼 느껴서 ing를 붙이기 쉬워요. Let's 뒤에는 항상 동사원형이에요." },
    { "wrong": "No touch the coffee machine.", "right": "Don't touch the coffee machine.", "why": "'만지지 마'의 '마'를 No로 바꾸는 실수예요. 하지 말라고 할 때는 Don't + 동사원형이에요." }
  ],
  "examples": [
